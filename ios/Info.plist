<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* build settings. -->
	<!-- The launch screen is the game's splash background, so there is no white flash. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Nearby one-tap joining (Nearby.swift). iOS shows this sentence the
	     first time the game looks for, or is found by, another device on the
	     local network: when Play together is first opened, never at launch. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Whisker Walk uses your local network to find a family member's device in the same room, so you can start a walk together without typing a code.</string>
	<!-- The one service it advertises and browses for (MultipeerRadio.serviceType). -->
	<key>NSBonjourServices</key>
	<array>
		<string>_whisker-walk._tcp</string>
		<string>_whisker-walk._udp</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<!-- Always full screen on iPad: no split view or slide over. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- One window, run by SceneDelegate (the iOS 27 SDK requires scenes). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
